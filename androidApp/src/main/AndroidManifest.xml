<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      首选并不需要它：悬浮窗走无障碍专属的 TYPE_ACCESSIBILITY_OVERLAY，系统直接放行。
      留着是因为真机上该类型可能被拒（实测 BadTokenException），那时会降级到
      TYPE_APPLICATION_OVERLAY —— 那一路才需要用户授权"显示在其他应用上层"。
      详见 overlay/OverlayController.kt 的降级链。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          截图与悬浮窗都走无障碍通道：
          - AccessibilityService#takeScreenshot（API 30+）静默截屏，没有录屏授权弹窗；
          - 悬浮窗用 TYPE_ACCESSIBILITY_OVERLAY，**不需要** SYSTEM_ALERT_WINDOW 权限。
        -->
        <service
            android:name=".capture.BrickGameAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/brickgame_accessibility" />
        </service>

        <!--
          分享低置信度留档的 ZIP：把 cache 里的文件包成 content:// 交给系统分享
          （直接给 file:// 在 Android 7+ 会抛 FileUriExposedException）。
          只暴露 lowconf-share/ 这一个子目录，见 res/xml/file_paths.xml。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
